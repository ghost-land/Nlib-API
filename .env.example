# Database Configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nlib_api
DB_USER=nlib_user
DB_PASSWORD=your_secure_password_here
DB_SSL=false

# For SSL connections (remote databases)
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# Application
PORT=3000
NODE_ENV=production

# CTR / 3dsdb local mirror (git clone of ghost-land/3dsdb)
# First sync clones ~1GB; later syncs only git fetch + filesystem diff.
# CTR_3DSDB_DIR=./data/3dsdb
# CTR_3DSDB_REPO=https://github.com/ghost-land/3dsdb.git
# CTR_3DSDB_BRANCH=main
# Keep sync gentle (defaults are safe for production API):
# CTR_META_CONCURRENCY=2
# CTR_MEDIA_CONCURRENCY=1
# CTR_MEDIA_YIELD_MS=40
# CTR_FORCE_MEDIA=1

# Optional: Enable debug mode for detailed database logs
# DB_DEBUG=true
